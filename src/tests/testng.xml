<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name = "antnele app" parallel="false">
	
	<test name = "Verify Login with valid credentials">
		<parameter name="Username" value="standard_user"></parameter>
		<parameter name="Password" value="secret_sauce"></parameter>
		<classes>
			<class name ="tests.loginTest"/>
		</classes>
		
	</test>
	
	<test name = "Verify login with invalid credentials">
		<parameter name="InvalidUsername" value="wrong"></parameter>
		<parameter name="InvalidPassword" value="secret_sauce"></parameter>
		<classes>
			<class name ="tests.loginTest"/>
		</classes>
		
	</test>
	
	<test name="Verify logout">
		<classes>
			<class name="tests.LogoutTest"></class>
		</classes>
	</test>
	
	<test name="verify Edge Cases">
		<parameter name="validUsername" value="standard_user"></parameter>
		<parameter name="emptyUsername" value=""></parameter>
		<parameter name="emptyPassword" value=""></parameter>
		<parameter name="validPassword" value="secret_sauce"></parameter>
		<parameter name="spacialCharacterUsername" value="standard@!@#@"></parameter>
		<parameter name="specialCharacterPassword" value="AK@%@%^@"></parameter>
		<classes>
			<class name="tests.Edge_Cases"></class>
		</classes>
	</test>
	
	<test name="Verify dashboard">
		<classes>
			<class name="tests.DashboardTest"></class>
		</classes>
	</test>
	
	<test name="Verify cart test">
		<classes>
			<class name="tests.DashboardTest"></class>
		</classes>
	</test>
</suite>